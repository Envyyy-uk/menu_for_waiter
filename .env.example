# Локальная разработка. Для продакшена все значения обязательно поменять.

DATABASE_URL=postgresql+psycopg://pos:pos@db:5432/pos

# Подпись сессионных токенов. В продакшене — случайная строка от 32 символов.
SECRET_KEY=dev-secret-change-me-in-production

# Первый администратор, которого создаёт сидер. PIN показывается один раз
# в логе запуска — дальше в базе только хеш.
SEED_ADMIN_NAME=Администратор
SEED_ADMIN_PIN=1234

# Сколько столов создать при первом запуске.
SEED_TABLES=12

PUBLIC_BASE_URL=http://localhost:8000

# Web Push (VAPID). Пустые ключи = push выключен, звук остаётся только
# внутри открытого приложения. Сгенерировать: python -m app.tools.vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
