# Локальная разработка. Для продакшена все значения обязательно поменять.

DATABASE_URL=postgresql+psycopg://pos:pos@db:5432/pos

# Подпись сессионных токенов. В продакшене — случайная строка от 32 символов.
SECRET_KEY=dev-secret-change-me-in-production

# Первый администратор, которого создаёт сидер. PIN — ровно четыре цифры,
# показывается один раз в логе запуска; дальше в базе только хеш.
SEED_ADMIN_NAME=Администратор
SEED_ADMIN_PIN=1234

# Сколько столов создать при первом запуске.
SEED_TABLES=12

PUBLIC_BASE_URL=http://localhost:8000

# Каталог меню на сайте. POS перечитывает его сам, поэтому позиции и цены
# вводятся один раз — в админке гостевого меню.
#
# Пустой адрес выключает синхронизацию: меню тогда живёт снимком из
# seed_menu.json и правится в админке POS.
MENU_SOURCE_URL=https://envyyy-uk.github.io/Menu-qr/data/menu.json
MENU_LABELS_URL=https://envyyy-uk.github.io/Menu-qr/data/ui.json
MENU_SYNC_MINUTES=5

# Web Push (VAPID). Пустые ключи = push выключен: приложение тогда не просит
# разрешение зря, а сигнал остаётся внутри открытого приложения — там он и
# так слышен при выключенном звонке.
#
# Сгенерировать пару:  docker compose run --rm api python -m app.tools.vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
