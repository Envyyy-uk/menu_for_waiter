#!/bin/bash
# Короткие команды вместо длинной строки docker compose.
#
# Владелец заведения не должен помнить, что база поднимается файлом из папки
# deploy с ключом --env-file. Ему нужно четыре вещи: посмотреть, что живо,
# почитать лог, перезапустить и обновить.
#
#   pos          что запущено
#   pos log      лог сервера, Ctrl+C выйти
#   pos restart  перезапустить
#   pos update   обновить приложение с гитхаба и перезапустить
#   pos backup   выгрузить базу прямо сейчас
#   pos pin      напомнить PIN владельца из .env
#   pos unlock   снять блокировку после неудачных попыток
#   pos newpin   выдать владельцу новый PIN (если старый потерян)
#   pos auto on  обновляться самому каждую ночь (off — выключить)
set -euo pipefail

ROOT=/srv/pos
C="docker compose --env-file $ROOT/.env -f $ROOT/deploy/docker-compose.prod.yml"

case "${1:-ps}" in
	ps|status|"")
		$C ps
		;;
	log|logs)
		$C logs -f --tail 100 api
		;;
	restart)
		$C up -d --build
		;;
	update)
		git -C "$ROOT" pull --ff-only
		# И сама команда обновляется вместе с приложением — иначе она
		# застынет на той версии, что стояла в день установки.
		#
		# Через переименование, а не поверх: bash дочитывает файл по ходу
		# выполнения, и переписать его под собой значит оборваться на
		# середине. Переименование меняет имя, а открытый файл остаётся тем
		# же до конца запуска.
		install -m 755 "$ROOT/deploy/pos" /usr/local/bin/pos.new
		mv /usr/local/bin/pos.new /usr/local/bin/pos
		$C up -d --build
		echo "обновлено"
		;;
	backup)
		"$ROOT/deploy/backup.sh"
		;;
	pin)
		# Только для первого входа: дальше PIN живёт в базе хешем, и здесь
		# останется тот, с которым заведение завели.
		grep '^SEED_ADMIN_PIN=' "$ROOT/.env" | cut -d= -f2
		;;
	auto)
		# Обновление раз в сутки, в пять утра. Час выбран не случайно:
		# заведение закрыто, гостей нет, и перезапуск на полминуты никого
		# не касается. Днём этого делать нельзя — контейнер поднимается
		# заново, и заказ в этот момент упрётся в «нет связи».
		#
		# Плата за удобство честная: обновление приезжает без вашего
		# участия, значит и ошибка приедет так же. Бэкап базы при этом
		# снимается каждый час, а откатиться можно `git -C /srv/pos
		# checkout <версия>` и `pos restart`.
		line="0 5 * * * /usr/local/bin/pos update >> /var/log/pos-update.log 2>&1"
		rest=$(crontab -l 2>/dev/null | grep -v 'pos update' || true)
		if [ "${2:-on}" = "off" ]; then
			printf '%s\n' "$rest" | crontab -
			echo "автообновление выключено"
		else
			printf '%s\n%s\n' "$rest" "$line" | grep -v '^$' | crontab -
			echo "автообновление включено: каждую ночь в 5:00"
		fi
		;;
	unlock)
		# Пять неудачных попыток — и вход ждёт пятнадцать минут. Перед
		# сменой столько не ждут.
		$C exec -T api python -m app.tools.pin --unlock
		;;
	newpin)
		# PIN владельца потерян. Заодно снимается блокировка: иначе человек
		# с новым PIN в руках упрётся в неё же.
		$C exec -T api python -m app.tools.pin ${2:-}
		;;
	*)
		echo "pos [ps|log|restart|update|backup|pin|unlock|newpin|auto]" >&2
		exit 1
		;;
esac
