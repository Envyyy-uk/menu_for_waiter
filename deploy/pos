#!/bin/bash
# Короткие команды вместо длинной строки docker compose.
#
# Владелец заведения не должен помнить, что база поднимается файлом из папки
# deploy с ключом --env-file. Ему нужно четыре вещи: посмотреть, что живо,
# почитать лог, перезапустить и обновить.
#
#   pos          что запущено
#   pos log      лог сервера, Ctrl+C выйти
#   pos restart  перезапустить
#   pos update   обновить приложение с гитхаба и перезапустить
#   pos backup   выгрузить базу прямо сейчас
#   pos pin      напомнить PIN владельца из .env
#   pos unlock   снять блокировку после неудачных попыток
#   pos newpin   выдать владельцу новый PIN (если старый потерян)
set -euo pipefail

ROOT=/srv/pos
C="docker compose --env-file $ROOT/.env -f $ROOT/deploy/docker-compose.prod.yml"

case "${1:-ps}" in
	ps|status|"")
		$C ps
		;;
	log|logs)
		$C logs -f --tail 100 api
		;;
	restart)
		$C up -d --build
		;;
	update)
		git -C "$ROOT" pull --ff-only
		$C up -d --build
		echo "обновлено"
		;;
	backup)
		"$ROOT/deploy/backup.sh"
		;;
	pin)
		# Только для первого входа: дальше PIN живёт в базе хешем, и здесь
		# останется тот, с которым заведение завели.
		grep '^SEED_ADMIN_PIN=' "$ROOT/.env" | cut -d= -f2
		;;
	unlock)
		# Пять неудачных попыток — и вход ждёт пятнадцать минут. Перед
		# сменой столько не ждут.
		$C exec -T api python -m app.tools.pin --unlock
		;;
	newpin)
		# PIN владельца потерян. Заодно снимается блокировка: иначе человек
		# с новым PIN в руках упрётся в неё же.
		$C exec -T api python -m app.tools.pin ${2:-}
		;;
	*)
		echo "pos [ps|log|restart|update|backup|pin|unlock|newpin]" >&2
		exit 1
		;;
esac
